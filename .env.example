# Скопировать в .env и заполнить MAIL_ADDRESS / MAIL_PASSWORD / EWS_SERVER /
# LLM_BASE_URL / LLM_API_KEY / ALLOWED_SENDERS. Остальные значения — рабочие дефолты.
#
# Почта — Microsoft Exchange через EWS, модель — sofi-mail в Open WebUI
# компании. Другой почты и другого шлюза к модели в сборке нет.
#
# ВАЖНО: python-dotenv отрезает хвостовой комментарий только у непустого значения
# (`KEY=   # текст` даст значением "# текст"), поэтому у пустых переменных комментарий — строкой выше.

# --- Почтовый ящик модели (Exchange) ---
# Отдельный ящик, в который не заходит человек: демон забирает непрочитанные
# письма, и открытый в Outlook ящик «съедал» бы их областью чтения.
MAIL_ADDRESS=sofi@example.com
MAIL_DISPLAY_NAME=Sofi
# пароль служебной учётной записи домена; не нужен при EWS_AUTH=gssapi/sspi/oauth2
MAIL_PASSWORD=
# Логин служебной учётки (НЕ ящик выше) — ей нужны права Send As и FullAccess на MAIL_ADDRESS,
# обычно CORP\svc-llm или UPN. Пусто = вход под самим ящиком (не годится для общего ящика — у него AD-учётка отключена).
MAIL_LOGIN=

# --- TLS ---
# false отключает проверку сертификата Exchange и открывает почту для перехвата.
# Это режим отладки: validate() с ним не пропускает старт
MAIL_TLS_VERIFY=true
# корневой сертификат внутреннего УЦ (PEM), если его нет в системном хранилище
MAIL_CA_FILE=

# --- EWS (Exchange Web Services) ---
# mail.company.ru; пусто = autodiscover, но в закрытом сегменте он часто недоступен
EWS_SERVER=
# полный URL, если он нестандартный: https://mail.company.ru/EWS/Exchange.asmx
EWS_ENDPOINT=
# basic | ntlm | gssapi | sspi | digest | oauth2; пусто = определить самому.
# В домене чаще всего ntlm; gssapi — по билету Kerberos, пароль тогда не нужен
EWS_AUTH=
EWS_ACCESS_TYPE=delegate             # impersonation, если служебная учётка работает «от имени» ящика
# Предел ожидания ответа Exchange, секунд. Без него запрос к недоступному серверу висит
# до таймаута сокета ОС, занимая поток обработки, а письмо не получает ответ.
EWS_TIMEOUT_SEC=120
EWS_FOLDER=inbox                     # или вложенная папка: "Входящие/LLM"
# Класть ли копию ответа в «Отправленные» ящика модели. Ящик общий на всех пользователей,
# значит «Отправленные» — общий архив переписки; история и так есть в БД, поэтому по умолчанию false.
EWS_SAVE_SENT=false

# --- OAuth2 (только при EWS_AUTH=oauth2) ---
# Регистрация приложения в Entra ID. Без MAIL_PASSWORD приложение работает от своего имени
# (нужен EWS_ACCESS_TYPE=impersonation); с MAIL_PASSWORD — от имени пользователя.
#
# ВАЖНО: право full_access_as_app даётся ко ВСЕМ ящикам тенанта — обязательно ограничить его
# одним ящиком модели (New-ApplicationAccessPolicy), иначе секрет открывает почту всей организации.
EWS_CLIENT_ID=
EWS_CLIENT_SECRET=
# пусто = тенант выберет Microsoft (common)
EWS_TENANT_ID=

# --- LLM (Open WebUI компании) ---
# Настройки модели живут не здесь: системный промпт, параметры генерации, базы знаний и
# фильтры заданы на модели sofi-mail в Open WebUI, правка — там же, без выкладки образа.
#
# Обязательное поле (дефолта нет намеренно). Заканчивается на /api (допишется сам); хвост /v1 —
# это адрес vLLM, с ним демон не стартует. ОБЯЗАТЕЛЬНО https: в запросе уходит вся переписка.
LLM_BASE_URL=https://llm.example.com/api
# корневой сертификат внутреннего УЦ, которым подписан сертификат Open WebUI
LLM_CA_FILE=
# Разрешить http до модели (изолированный сегмент/отладка). Без флага демон с http не стартует.
LLM_ALLOW_INSECURE=false
# Model ID модели рабочего пространства (Workspace -> Models), не путь репозитория на сервере
# инференса — имя базовой модели увело бы запрос мимо sofi-mail, без промпта и фильтров.
LLM_MODEL=sofi-mail
LLM_TIMEOUT_SEC=300                  # поднять, если сервер общий и запросы стоят в очереди
# Ключ API сервисной учётки (Settings -> Account -> API keys). Обязателен:
# Open WebUI без него отвечает 401, и он же определяет, чью модель видит демон
LLM_API_KEY=

# Адрес веб-интерфейса Open WebUI — уходит в письмо, когда документ почтой обработать нельзя
# («задайте вопрос там»). Пусто — берётся из LLM_BASE_URL без /api
LLM_WEB_URL=
# Id кастомных Tools рабочего пространства (Workspace -> Tools), через запятую — вызывать их или
# нет решает модель. Встроенных тулов Open WebUI это не касается. Пусто по умолчанию
LLM_TOOL_IDS=
# false оставляет чат в Open WebUI после ответа вместо удаления — на время наблюдения
# за Path A через интерфейс. По умолчанию true (чат удаляется)
LLM_DELETE_CHAT=true

# --- Поведение демона ---
POLL_INTERVAL_SEC=20
MARK_SEEN=true
DRY_RUN=false                        # true: генерировать ответ, но не отправлять письмо
WORKERS=1                            # писем одновременно; потолок задают Open WebUI с сервером инференса и троттлинг EWS

# --- Доступ и лимиты ---
# Адреса через запятую. Перечисляйте конкретных людей: запись вида @company.ru открывает
# домен целиком — пускает любого сотрудника, включая того, кому переслали чужой тред.
ALLOWED_SENDERS=
# Разрешить записи на весь домен в ALLOWED_SENDERS. Без него такой конфиг не стартует —
# расширение доступа к чужой переписке должно быть осознанным решением, а не дефолтом.
ALLOW_DOMAIN_WILDCARD=false
# Потолок длины одного письма, в символах; 0 — не обрезать. Обрезка снимает
# часть условий вопроса, о которой модель не узнает, поэтому по умолчанию 0
MAX_PROMPT_CHARS=0
# Сколько реплик сессии читать из базы; 0 — все. Контекст сессии не обрезается
# по числу строк: его объём держит свёртка в сводку (см. ниже)
MAX_HISTORY_MESSAGES=0
# Порог на весь запрос (история + письмо), в символах. Не обрезка: превышение только пишется
# в лог (llm.fit_context), запрос уходит целиком. Ориентир — окно модели в токенах × 3.
MAX_CONTEXT_CHARS=60000

# --- Суммаризация сессии -----------------------------------------------------
# Свёртка переписки в сводку — без неё длинная сессия упирается в окно модели, и сервер
# отвергает запрос целиком. false оставляет сессию расти как есть.
SUMMARY_ENABLED=true
# Предел объёма сессии в символах; при достижении реплики до текущего письма заменяются
# сводкой. Держится ниже MAX_CONTEXT_CHARS — разница отведена под письмо и описания документов.
SESSION_MAX_CHARS=40000
# Коэффициент сжатия сводки (0.2 — впятеро короче, модель держит его приблизительно).
# Завышение приближает следующую свёртку, занижение теряет детали.
SUMMARY_COMPRESSION_RATIO=0.2
# Потолок блока описаний документов перед письмом, в символах. Без потолка блок вместе с
# письмом может перерасти MAX_CONTEXT_CHARS и вытеснить всю историю сессии. 0 — не ограничивать.
MAX_ATTACHMENT_CONTEXT_CHARS=20000
RATE_LIMIT_PER_HOUR=20

# --- Вложения --- документ уезжает в Open WebUI как есть; режим подачи (поиск/целиком)
# выбирает сервер/full_context_tool.py. false — вложения игнорируются, ответ идёт по тексту письма.
ATTACHMENTS_ENABLED=true
# Потолок на один файл. Держит и трафик до owui, и время разбора на его
# стороне: файл на сотню мегабайт занимает поток обработки на минуты
ATTACHMENT_MAX_MB=20
ATTACHMENT_MAX_COUNT=5               # файлов из одного письма
ATTACHMENT_MAX_SESSION_FILES=10      # файлов треда в одном запросе к модели
ATTACHMENT_PROCESS_TIMEOUT_SEC=120   # сколько ждать индексации файла в owui
# Срок жизни файла в Open WebUI, дней; 0 — не удалять. Слишком короткий срок молча выкидывает
# документ из живой сессии. Переменная отдельная от RETENTION_DAYS — файлы лежат в более широком
# доступе (общая сервисная учётка), и их срок можно укоротить осознанно.
ATTACHMENT_RETENTION_DAYS=90
# Разрешено ли фактически удалять файлы в Open WebUI. false оставляет их на месте при любой
# причине уборки; отметка об удалении в базе не ставится. Расхождение показывает `reconcile`.
ATTACHMENT_DELETE_ENABLED=true

# --- Сессии и хранилище ---
# Каталог базы демон держит с правами 0700, файл — 0600: в базе лежит переписка
# целиком, и с правами по умолчанию её читал бы любой пользователь сервера
DB_PATH=data/sessions.db
# В компании темы вроде «Вопрос» повторяются постоянно, и фоллбэк по теме
# склеит переписки разных людей в одну сессию — поэтому false
THREAD_BY_SUBJECT=false
# Срок хранения переписки в днях; 0 — бессрочно (тогда ущерб от компрометации базы растёт
# вечно). Демон чистит базу сам раз в сутки, разово — командой `purge`.
RETENTION_DAYS=90
# Хранить ли тело письма вместе с цитатой (там вся прежняя переписка треда, включая третьих
# лиц). Нужно только для разбора промахов эвристики цитат (`history --raw`).
STORE_RAW_BODY=false

# --- Журналирование ---
# true пишет в лог адреса и темы писем как есть — лог уходит в систему сбора логов с более
# широким кругом читателей, чем допущенные к переписке. Включать на время разбора проблемы.
LOG_PII=false