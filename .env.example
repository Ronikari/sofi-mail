# Скопировать в .env и заполнить MAIL_ADDRESS / MAIL_PASSWORD / ALLOWED_SENDERS.
# Остальные значения — рабочие дефолты, менять не обязательно.

# --- Почтовый ящик модели (Gmail + App Password, нужна включённая 2FA) ---
MAIL_ADDRESS=llm.assistant@gmail.com
MAIL_PASSWORD=                       # 16-символьный app password, БЕЗ пробелов
MAIL_DISPLAY_NAME=Local LLM
MAIL_LOGIN=                          # пусто = логин совпадает с адресом; в Exchange бывает CORP\svc-llm

# imap — IMAP + SMTP (публичные провайдеры и Exchange с включённой службой IMAP4)
# ews  — Exchange Web Services (нужен pip install -r requirements-ews.txt)
MAIL_TRANSPORT=imap

# --- TLS ---
MAIL_TLS_VERIFY=true                 # false отключает проверку сертификата: только для самоподписанного Exchange
MAIL_CA_FILE=                        # корневой сертификат внутреннего УЦ, если он не в системном хранилище

# --- IMAP (приём) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_STARTTLS=false                  # true: подключаться на 143 и поднимать TLS через STARTTLS

# --- SMTP (отправка) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=starttls                    # starttls (587) | ssl (465) | none (внутренний релей на 25)
SMTP_AUTH=true                       # false для коннектора внутреннего релея Exchange: он не объявляет AUTH

# --- EWS (нужно только при MAIL_TRANSPORT=ews) ---
EWS_SERVER=                          # mail.company.ru; пусто = autodiscover по домену адреса
EWS_ENDPOINT=                        # полный URL, если он нестандартный
EWS_AUTH=                            # basic | ntlm | gssapi | sspi | digest | oauth2; пусто = определить самому
EWS_ACCESS_TYPE=delegate             # impersonation, если служебная учётка работает «от имени» ящика
EWS_FOLDER=inbox                     # или вложенная папка: "Входящие/LLM"

# --- OAuth2 (только при EWS_AUTH=oauth2) ---
# Регистрация приложения в Entra ID. Без MAIL_PASSWORD приложение работает
# от своего имени — тогда обязателен EWS_ACCESS_TYPE=impersonation.
# С MAIL_PASSWORD — от имени пользователя, и impersonation не нужен.
EWS_CLIENT_ID=
EWS_CLIENT_SECRET=
EWS_TENANT_ID=                       # пусто = тенант выберет Microsoft (common)

# --- Ollama / LLM ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=6144              # покрывает thinking (~2-3.5K токенов) И сам ответ
OLLAMA_TEMPERATURE=0.6
LLM_TIMEOUT_SEC=300
SYSTEM_PROMPT_FILE=prompts/system.txt

# --- Поведение демона ---
POLL_INTERVAL_SEC=20
MARK_SEEN=true
DRY_RUN=false                        # true: генерировать ответ, но не отправлять письмо
WORKERS=1                            # писем одновременно; поднимать вместе с OLLAMA_NUM_PARALLEL

# --- Доступ и лимиты ---
ALLOWED_SENDERS=                     # адреса через запятую; @company.ru разрешает домен целиком
MAX_PROMPT_CHARS=20000
MAX_HISTORY_MESSAGES=40
RATE_LIMIT_PER_HOUR=20

# --- Сессии и хранилище ---
DB_PATH=data/sessions.db
THREAD_BY_SUBJECT=true               # искать сессию по теме, если письмо потеряло In-Reply-To
