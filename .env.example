# Скопировать в .env и заполнить MAIL_ADDRESS / MAIL_PASSWORD / EWS_SERVER /
# LLM_BASE_URL / LLM_API_KEY / ALLOWED_SENDERS. Остальные значения — рабочие дефолты.
#
# Почта — Microsoft Exchange через EWS, модель — sofi-mail в Open WebUI
# компании. Другой почты и другого шлюза к модели в сборке нет.
#
# ВАЖНО про комментарии: python-dotenv отрезает хвостовой комментарий только у
# НЕПУСТОГО значения. Строка вида `KEY=   # пояснение` даёт значение "# пояснение",
# а не пустоту. Поэтому у переменных без значения комментарий стоит строкой выше.

# --- Почтовый ящик модели (Exchange) ---
# Отдельный ящик, в который не заходит человек: демон забирает непрочитанные
# письма, и открытый в Outlook ящик «съедал» бы их областью чтения.
MAIL_ADDRESS=sofi@so-ups.ru
MAIL_DISPLAY_NAME=Sofi
# пароль служебной учётной записи домена; не нужен при EWS_AUTH=gssapi/sspi/oauth2
MAIL_PASSWORD=
# Логин доменной учётной записи, заведённой под программу, — это НЕ ящик выше.
# Демон входит как она, а работает с ящиком MAIL_ADDRESS, поэтому ей нужны права
# Send As и FullAccess на этот ящик; собственный ящик ей не нужен. В домене
# обычно CORP\svc-llm или UPN. Пусто = вход под самим ящиком: так можно, только
# если ящик не общий (у общего ящика учётная запись AD отключена)
MAIL_LOGIN=

# --- TLS ---
# false отключает проверку сертификата Exchange и открывает почту для перехвата.
# Это режим отладки: validate() с ним не пропускает старт
MAIL_TLS_VERIFY=true
# корневой сертификат внутреннего УЦ (PEM), если его нет в системном хранилище
MAIL_CA_FILE=

# --- EWS (Exchange Web Services) ---
# mail.company.ru; пусто = autodiscover, но в закрытом сегменте он часто недоступен
EWS_SERVER=
# полный URL, если он нестандартный: https://mail.company.ru/EWS/Exchange.asmx
EWS_ENDPOINT=
# basic | ntlm | gssapi | sspi | digest | oauth2; пусто = определить самому.
# В домене чаще всего ntlm; gssapi — по билету Kerberos, пароль тогда не нужен
EWS_AUTH=
EWS_ACCESS_TYPE=delegate             # impersonation, если служебная учётка работает «от имени» ящика
# Предел ожидания ответа Exchange, секунд. Без него запрос к недоступному
# серверу висит до таймаута сокета ОС: поток обработки письма занят всё это
# время, а заявка остаётся в processing и письмо ответа не получает
EWS_TIMEOUT_SEC=120
EWS_FOLDER=inbox                     # или вложенная папка: "Входящие/LLM"
# Класть ли копию ответа в «Отправленные» ящика модели. Ящик один на всех
# пользователей сервиса, поэтому его «Отправленные» — общий архив переписки:
# кому выданы права на ящик, тот читает ответы всем. История есть в БД,
# а у пользователя ответ остаётся в его почте, поэтому по умолчанию false
EWS_SAVE_SENT=false

# --- OAuth2 (только при EWS_AUTH=oauth2) ---
# Регистрация приложения в Entra ID. Без MAIL_PASSWORD приложение работает
# от своего имени — тогда обязателен EWS_ACCESS_TYPE=impersonation.
# С MAIL_PASSWORD — от имени пользователя, и impersonation не нужен.
#
# ВАЖНО: право full_access_as_app даётся ко ВСЕМ ящикам тенанта. Область
# обязательно ограничить одним ящиком модели (New-ApplicationAccessPolicy либо
# принятый в тенанте механизм RBAC for Applications) — иначе секрет ниже
# открывает почту всей организации. Там, где NTLM не отключён, ntlm + delegate
# безопаснее: он открывает ровно один ящик. Подробнее — в server_guide.md
EWS_CLIENT_ID=
EWS_CLIENT_SECRET=
# пусто = тенант выберет Microsoft (common)
EWS_TENANT_ID=

# --- LLM (Open WebUI компании) ---
# Настройки модели живут не здесь. В рабочем пространстве Open WebUI под
# сервисной учётной записью заведена модель sofi-mail, и на ней задано всё,
# что определяет ответ: системный промпт, параметры генерации, базы знаний
# и фильтры. Правка — там же, без выкладки образа.
#
# Обязательное поле: дефолта нет намеренно, иначе демон молча ходил бы к себе же.
# Адрес заканчивается на /api (допишется сам, если забыть) — генерация идёт по
# POST /api/chat/completions. Хвост /v1 — это адрес vLLM, с ним демон не стартует.
# ОБЯЗАТЕЛЬНО https: в запросе к модели уходит полный текст письма и вся история
# сессии, по http это открытый текст в корпоративной сети
LLM_BASE_URL=https://sofi.cdu.so/api
# корневой сертификат внутреннего УЦ, которым подписан сертификат Open WebUI
LLM_CA_FILE=
# Разрешить http до модели. Осознанный отказ от шифрования — изолированный
# сегмент, отладка. Без этого флага демон с http-адресом не стартует
LLM_ALLOW_INSECURE=false
# Model ID модели рабочего пространства (Workspace -> Models), а не путь
# репозитория на сервере инференса: имя базовой модели увело бы запрос мимо
# sofi-mail — без промпта, знаний и фильтров. Сверяется точным равенством
LLM_MODEL=sofi-mail
LLM_TIMEOUT_SEC=300                  # поднять, если сервер общий и запросы стоят в очереди
# Ключ API сервисной учётки (Settings -> Account -> API keys). Обязателен:
# Open WebUI без него отвечает 401, и он же определяет, чью модель видит демон
LLM_API_KEY=

# Адрес веб-интерфейса того же Open WebUI. Уходит в письмо пользователю тогда,
# когда документ почтой обработать нельзя (см. вложения ниже) — «задайте вопрос
# там». Пусто — берётся из LLM_BASE_URL без служебного /api
LLM_WEB_URL=

# --- Поведение демона ---
POLL_INTERVAL_SEC=20
MARK_SEEN=true
DRY_RUN=false                        # true: генерировать ответ, но не отправлять письмо
WORKERS=1                            # писем одновременно; потолок задают Open WebUI с сервером инференса и троттлинг EWS

# --- Доступ и лимиты ---
# Адреса через запятую. Перечисляйте конкретных людей: запись вида @company.ru
# открывает домен целиком, то есть пускает любого сотрудника — в том числе того,
# кому переслали чужой тред
ALLOWED_SENDERS=
# Разрешить записи на весь домен в ALLOWED_SENDERS. Без него такой конфиг
# не стартует: ширина доступа прямо задаёт число людей, способных добраться
# до чужой переписки, и расширять её нужно решением, а не по умолчанию
ALLOW_DOMAIN_WILDCARD=false
# Потолок длины одного письма, в символах; 0 — не обрезать. Обрезка снимает
# часть условий вопроса, о которой модель не узнает, поэтому по умолчанию 0
MAX_PROMPT_CHARS=0
# Сколько реплик сессии читать из базы; 0 — все. Контекст сессии не обрезается
# по числу строк: его объём держит свёртка в сводку (см. ниже)
MAX_HISTORY_MESSAGES=0
# Порог на весь запрос (история сессии + текущее письмо), в символах.
# Не настройка модели и не обрезка: превышение пишется в лог функцией
# llm.fit_context, а запрос уходит целиком. Объём сессии держит свёртка ниже.
# Окно задано на модели sofi-mail в Open WebUI и клиенту не видно.
# Ориентир — окно в токенах, умноженное на 3, с запасом на ответ
MAX_CONTEXT_CHARS=60000

# --- Суммаризация сессии -----------------------------------------------------
# Свёртка переписки в сводку. Переписка треда растёт без предела, окно модели
# конечно: без свёртки длинная сессия упирается в него, и сервер отвергает
# запрос целиком. false оставляет сессию расти как есть
SUMMARY_ENABLED=true
# Предел объёма сессии в символах (реплики истории + текст текущего письма).
# При достижении предела реплики до текущего письма заменяются одной сводкой.
# Держится ниже MAX_CONTEXT_CHARS: разница отведена под текущее письмо
# и блок описаний документов
SESSION_MAX_CHARS=40000
# Коэффициент сжатия: какую долю от объёма свёрнутой переписки занимает сводка.
# 0.2 — сводка впятеро короче. Значение уходит в запрос целевым числом
# символов, модель держит его приблизительно. Завышение оставляет сводку
# подробной и приближает следующую свёртку, занижение теряет детали
SUMMARY_COMPRESSION_RATIO=0.2
# Потолок блока описаний документов, который встаёт в запрос перед текстом
# письма, в символах. Блок собирается из описаний до
# ATTACHMENT_MAX_SESSION_FILES документов с оглавлениями, и без потолка вместе
# с письмом перерастает MAX_CONTEXT_CHARS: история сессии тогда отбрасывается
# целиком, а запрос уходит на сервер без обрезки. 0 — не ограничивать
MAX_ATTACHMENT_CONTEXT_CHARS=20000
RATE_LIMIT_PER_HOUR=20

# --- Вложения ---
# Документ из письма разбирается локально (unstructured), а его текст уезжает
# файлом в Open WebUI по /api/v1/files/ и живёт там до срока хранения ниже.
# Чат в owui при этом не создаётся: история остаётся в этой базе.
# false — вложения игнорируются, пользователь получает ответ по тексту письма
# с примечанием
ATTACHMENTS_ENABLED=true
ATTACHMENT_MAX_MB=20                 # потолок на один файл
ATTACHMENT_MAX_COUNT=5               # файлов из одного письма
ATTACHMENT_MAX_SESSION_FILES=10      # файлов треда в одном запросе к модели
# До этого числа страниц документ уходит целиком (context=full), дальше —
# фокусированный поиск Open WebUI плюс оглавление в тексте запроса.
# Страницы свои: физически они есть только у PDF и у слайдов презентации,
# а docx, csv, txt и листы книги xlsx размечаются по объёму текста, из расчёта
# 1800 знаков на страницу (картинки в счёт не идут — модель видит только текст)
ATTACHMENT_FULL_CONTEXT_PAGES=20
# Та же граница по объёму извлечённого текста, в символах: страница — мера
# вёрстки, а не текста, и двадцать страниц выгрузки на порядок толще двадцати
# страниц регламента, а у docx, xlsx и txt страниц нет вовсе. Целиком уходит
# только документ, прошедший оба порога; не прошёл любой — дальше как
# с длинным: поиск и та же проверка оглавления. Считается по тексту, а не по
# весу файла в письме: вес держит ATTACHMENT_MAX_MB и об объёме текста ничего
# не говорит — скан на 2 МБ несёт одну страницу, docx на 200 КБ — пятьсот.
# Ориентир — ATTACHMENT_FULL_CONTEXT_PAGES по 1800 знаков (машинописная страница)
ATTACHMENT_FULL_CONTEXT_CHARS=40000
# Поиск за этим порогом ведёт оглавление, собранное из заголовков документа,
# и здесь — сколько страниц вправе приходиться на один заголовок, чтобы
# оглавление считалось картой (но не меньше трёх заголовков на документ).
# Документ, не прошедший проверку, в работу не берётся вовсе: в Open WebUI он
# не загружается, а пользователю уходит объяснение и что делать дальше —
# прислать нужную часть отдельно или спросить в LLM_WEB_URL. Так внутренние
# файлы без разделов — выгрузки, сметы, сшитая переписка — не превращаются
# в ответ по случайной трети текста, неотличимый в письме от полного
ATTACHMENT_OUTLINE_PAGES_PER_ENTRY=10
# Потолок на документ целиком, в символах извлечённого текста: выше него
# документ не берётся ни целиком, ни поиском — не загружается в Open WebUI,
# а пользователю уходит объяснение и те же два пути. Нужен потому, что дальше
# защиты нет: требование к оглавлению растёт вместе с документом, но упирается
# в потолок самого оглавления (60 строк) примерно на миллионе знаков, и выше
# этой отметки документ любого объёма с шестьюдесятью заголовками проходил бы
# проверку. Отсюда и значение: ровно та отметка (~550 машинописных страниц).
# ATTACHMENT_MAX_MB тут не помощник — он про вес файла, а в 20 МБ docx
# помещаются сотни миллионов знаков. 0 — не ограничивать
ATTACHMENT_MAX_CHARS=1000000
ATTACHMENT_PROCESS_TIMEOUT_SEC=120   # сколько ждать индексации файла в owui
# Срок жизни файла в Open WebUI, дней; 0 — не удалять. По умолчанию совпадает
# с RETENTION_DAYS: при более коротком сроке документ пропадает из контекста
# живой сессии, и следующее письмо треда получает ответ без документа без
# единого уведомления. Переменная отдельная потому, что файлы лежат под общей
# сервисной учёткой, то есть в более широком доступе, чем эта база, — срок
# для них можно укоротить осознанно
ATTACHMENT_RETENTION_DAYS=90
# Разрешено ли фактически удалять файлы в Open WebUI. false оставляет их
# на месте при любой причине уборки: истёкший срок, purge-files, purge, forget,
# снятие файлов после --dry-run. Отметка об удалении в базе при этом не
# ставится, и файл попадает в следующую уборку. Расхождение хранилища с базой
# показывает команда `reconcile`
ATTACHMENT_DELETE_ENABLED=true

# --- Сессии и хранилище ---
# Каталог базы демон держит с правами 0700, файл — 0600: в базе лежит переписка
# целиком, и с правами по умолчанию её читал бы любой пользователь сервера
DB_PATH=data/sessions.db
# В компании темы вроде «Вопрос» повторяются постоянно, и фоллбэк по теме
# склеит переписки разных людей в одну сессию — поэтому false
THREAD_BY_SUBJECT=false
# Срок хранения переписки в днях; 0 — бессрочно. Демон чистит базу сам раз
# в сутки, разово — командой `purge`. Бессрочное хранение означает, что ущерб
# от компрометации базы растёт вечно
RETENTION_DAYS=90
# Хранить ли тело письма вместе с цитатой. В цитате едет вся прежняя переписка
# треда, включая реплики третьих лиц, которые сервису не писали. Нужно только
# для разбора промахов эвристики цитат (`history --raw`)
STORE_RAW_BODY=false

# --- Журналирование ---
# true пишет в лог адреса и темы писем как есть. Лог уходит в journald и дальше
# в систему сбора логов, где круг читателей шире круга допущенных к переписке,
# а тема письма содержательна сама по себе. Включать на время разбора проблемы
LOG_PII=false
