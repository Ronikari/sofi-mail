# Что не должно попасть в контекст сборки.
#
# Первые две записи — не про размер образа. Контекст сборки целиком уходит
# демону Docker, а .env содержит пароль служебной учётки, data/ — переписку
# должностных лиц. В образе ни того, ни другого быть не может: конфигурация
# приходит окружением при запуске, база живёт в томе.
.env
.env.*
!.env.example
data/
*.db
*.db-journal
*.db-wal
*.db-shm

.git/
.gitignore
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store

# документация в образе не нужна: он не читается человеком
README.md

tests/stand/

Dockerfile
.dockerignore
docker-compose.yml
