#!/bin/sh
# pre-push: гоняет тестовую стадию Dockerfile перед push.
# смысл — не столько сам pytest (его можно запустить локальным .venv), сколько
# проверка, что тестовый образ вообще собирается: тот же базовый образ, те же
# системные библиотеки (libxml2/libxslt под lxml), та же версия Python и ровно
# requirements.txt + requirements-dev.txt, что уедут в боевой слой.
# CI в проекте нет, поэтому это единственный автоматический гейт перед push —
# без него requirements-dev.txt может пропасть из репозитория незамеченным
# (см. sofi-mail-known-issues.md, п.19/21) и всплыть на выкладке
#
# включается один раз на клоне: git config core.hooksPath .githooks
# пропустить разово: SKIP_DOCKER_TEST=1 git push

if [ -n "$SKIP_DOCKER_TEST" ]; then
    echo "pre-push: SKIP_DOCKER_TEST задан, тестовая сборка пропущена"
    exit 0
fi

echo "pre-push: docker build --target test ."
if ! docker build --target test . ; then
    echo "pre-push: тестовая стадия не прошла — push остановлен" >&2
    echo "pre-push: пропустить разово — SKIP_DOCKER_TEST=1 git push" >&2
    exit 1
fi
